# ═══════════════════════════════════════════════════════════════════════════
#  Site2Local — .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Environment / secrets ───────────────────────────────────────────────────
.env
.env.*

# ── Data generated at runtime by Site2Local ─────────────────────────────────
# The mirrored website (editable offline) and per-site metadata:
site_src/
site_data/
# Stray capture folders (normally under site_data/<site>/):
captures/
captures_ws/
# Hook stores written by the GUI/scan features (normally under site_data/):
s2l_hooks*.json
# Logs:
logs/
*.log

# NOTE: Wordlists/ is NOT ignored — wordlist files are user-curated inputs
# for SCAN_PATHS and belong in the repository.

# ── Editors / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
